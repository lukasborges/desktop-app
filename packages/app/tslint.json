{
  "extends": [
    "tslint-config-station",
    "tslint-react"
  ],
  "rules": {
    "align": false,
    "ordered-imports": false,
    "indent": false,
    "ter-indent": false,
    "max-line-length": false,
    "typedef": false,
    "one-line": false,
    "no-increment-decrement": false,
    "no-shadowed-variable": false,
    "brace-style": false,
    "variable-name": false,
    "function-name": false,
    "jsx-no-lambda": false,
    "jsx-no-bind": [true, {}],
    "jsx-self-close": [true, {}],
    "jsx-no-multiline-js": false,
    "import-blacklist": false
  },
  "linterOptions": {
    "exclude": [
      "**/*generated.ts?(x)",
      "**/*.json"
    ]
  }
}
