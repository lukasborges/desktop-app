{
  "extends": [
    "tslint-config-station",
    "tslint-react"
  ],
  "rules": {
    "jsx-no-lambda": false,
    "jsx-no-multiline-js": false,
    "no-import-side-effect": [true, {
      "ignore-module": "(\\.css)$"
    }]
  },
  "linterOptions": {
    "exclude": [
      "**/*generated.ts?(x)",
      "src/types.ts"
    ]
  }
}
